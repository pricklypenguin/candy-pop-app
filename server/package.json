{
  "name": "steady-sync-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "tsx src/dev.ts",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply steady-sync --local",
    "db:migrate:remote": "wrangler d1 migrations apply steady-sync --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.141.0"
  }
}
